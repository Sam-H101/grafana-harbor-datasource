# Configuration of the throwaway Harbor for the dev stack and the tests.
# devenv/harbor/harbor.sh fills in the @...@ values and hands the result to
# Harbor's own "prepare" image, which generates Harbor's docker-compose.yml.

# The name Grafana and the seed reach Harbor's proxy container under, on
# Harbor's Docker network. Harbor puts it into the links it hands out.
hostname: proxy
external_url: http://proxy:8080

http:
  # Published on the host, for opening Harbor in a browser.
  port: @HARBOR_PORT@

harbor_admin_password: @HARBOR_ADMIN_PASSWORD@

database:
  password: dev-only
  max_idle_conns: 20
  max_open_conns: 100
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

data_volume: @HARBOR_HOME@/data

trivy:
  ignore_unfixed: false
  skip_update: false
  skip_java_db_update: true
  offline_scan: false
  security_check: vuln
  insecure: false
  timeout: 10m0s

jobservice:
  max_job_workers: 4
  max_job_duration_hours: 24
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: info
  local:
    rotate_count: 5
    rotate_size: 50M
    location: @HARBOR_HOME@/log

_version: 2.15.0

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
