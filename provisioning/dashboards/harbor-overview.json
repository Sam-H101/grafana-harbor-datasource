{
  "uid": "harbor-overview",
  "title": "Harbor overview",
  "tags": ["harbor"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "smartquinoa1504-harbor-datasource",
          "uid": "harbor-dev"
        },
        "query": {
          "refId": "variable",
          "list": "projects"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "custom",
        "query": "Critical,High,Medium,Low",
        "options": [
          {
            "text": "Critical",
            "value": "Critical",
            "selected": true
          },
          {
            "text": "High",
            "value": "High",
            "selected": false
          },
          {
            "text": "Medium",
            "value": "Medium",
            "selected": false
          },
          {
            "text": "Low",
            "value": "Low",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "Critical",
          "value": "Critical"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Totals",
      "description": "Projects, repositories and storage this login can see, and the free space of the disk the registry stores on.",
      "type": "stat",
      "datasource": {
        "type": "smartquinoa1504-harbor-datasource",
        "uid": "harbor-dev"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "smartquinoa1504-harbor-datasource",
            "uid": "harbor-dev"
          },
          "queryType": "statistics"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^(Projects|Repositories|Storage used|Disk free %)$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Vulnerabilities",
      "description": "Findings of the vulnerability scanner in everything that was scanned.",
      "type": "stat",
      "datasource": {
        "type": "smartquinoa1504-harbor-datasource",
        "uid": "harbor-dev"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "smartquinoa1504-harbor-datasource",
            "uid": "harbor-dev"
          },
          "queryType": "securitySummary"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(total|fixable|scanned_artifacts|artifacts|unknown|low)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Projects",
      "description": "Storage used and quota of each project.",
      "type": "table",
      "datasource": {
        "type": "smartquinoa1504-harbor-datasource",
        "uid": "harbor-dev"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "smartquinoa1504-harbor-datasource",
            "uid": "harbor-dev"
          },
          "queryType": "projects",
          "projects": ["$project"]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "quota_used"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "owner"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "created"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
