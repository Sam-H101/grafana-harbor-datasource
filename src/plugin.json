      "oci",
      "images",
      "vulnerabilities",
      "trivy",
      "replication",
      "goharbor"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Source code", "url": "https://github.com/Sam-H101/grafana-harbor-datasource" },
      { "name": "Documentation", "url": "https://github.com/Sam-H101/grafana-harbor-datasource#readme" },
      { "name": "Report an issue", "url": "https://github.com/Sam-H101/grafana-harbor-datasource/issues" },
      {
